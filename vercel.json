{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/app/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/dist/app/browser/assets/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/dist/app/browser/assets/robots.txt"
    },
    {
      "source": "/(assets/.*|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|webm|mp4))$",
      "destination": "/dist/app/browser/$1"
    },
    {
      "source": "/blog/wp-admin",
      "destination": "http://elisabethkoch.eu"
    },
    {
      "source": "/blog/wp-login.php",
      "destination": "http://elisabethkoch.eu"
    },
    {
      "source": "/blog",
      "destination": "http://elisabethkoch.eu/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "http://elisabethkoch.eu/blog/:path*"
    },
    {
      "source": "/((?!blog).*)",
      "destination": "/api/index.js"
    }
  ]
}
