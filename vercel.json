{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/app/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/blog/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/dist/app/browser/assets/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/dist/app/browser/assets/robots.txt"
    },
    {
      "source": "/(assets/.*|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|webm|mp4))$",
      "destination": "/dist/app/browser/$1"
    },
    { "source": "/blog", "destination": "http://elisabethkoch.eu" },
    {
      "source": "/blog/wp-admin",
      "destination": "http://elisabethkoch.euwp-admin/"
    },
    {
      "source": "/blog/wp-login.php",
      "destination": "http://elisabethkoch.euwp-login.php"
    },
    {
      "source": "/blog/:path*",
      "destination": "http://elisabethkoch.eu:path*"
    },
    {
      "source": "/((?!blog|wp-).*)",
      "destination": "/api/index.js"
    }
  ]
}
